<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_mobile_sale" model="ir.actions.report">
        <field name="name">Sale Receipt</field>
        <field name="model">mobile.sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mobile_shop_pos.report_mobile_sale_document</field>
        <field name="report_file">mobile_shop_pos.report_mobile_sale_document</field>
        <field name="binding_model_id" ref="model_mobile_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mobile_sale_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <div class="page" style="font-family: monospace; max-width: 320px; margin: 0 auto;">

                        <div style="text-align: center; margin-bottom: 10px;">
                            <h3 style="margin: 0;">Mobile Shop</h3>
                            <div>Sale Receipt</div>
                        </div>

                        <div style="border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 5px 0; margin-bottom: 8px;">
                            <div>Bill No: <span t-field="o.name"/></div>
                            <div>Date: <span t-field="o.sale_date"/></div>
                        </div>

                        <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px dashed #000;">
                                    <th style="text-align: left;">Item</th>
                                    <th style="text-align: center;">Qty</th>
                                    <th style="text-align: right;">Price</th>
                                    <th style="text-align: right;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td style="text-align: left;"><span t-field="line.product_id.name"/></td>
                                    <td style="text-align: center;"><span t-field="line.quantity"/></td>
                                    <td style="text-align: right;"><span t-field="line.price" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td style="text-align: right;"><span t-field="line.subtotal" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="border-top: 1px dashed #000; margin-top: 8px; padding-top: 8px; text-align: right; font-weight: bold; font-size: 14px;">
                            Total: <span t-field="o.total_amount" t-options="{'widget': 'float', 'precision': 2}"/>
                        </div>

                        <div style="margin-top: 8px; font-size: 12px;">
                            <div>Payment: <span t-field="o.payment_method"/></div>
                            <t t-if="o.payment_method == 'cash'">
                                <div>Tendered: <span t-field="o.amount_tendered" t-options="{'widget': 'float', 'precision': 2}"/></div>
                                <div>Change: <span t-field="o.change_due" t-options="{'widget': 'float', 'precision': 2}"/></div>
                            </t>
                        </div>

                        <div style="text-align: center; margin-top: 15px; font-size: 11px;">
                            Thank you for your purchase!
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>