<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="seq_mobile_sale_order" model="ir.sequence">
        <field name="name">Mobile Sale Bill</field>
        <field name="code">mobile.sale.order</field>
        <field name="prefix">BILL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_mobile_product_barcode" model="ir.sequence">
        <field name="name">Mobile Product Barcode</field>
        <field name="code">mobile.product.barcode</field>
        <field name="padding">10</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>