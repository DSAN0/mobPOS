<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_mobile_shop" model="ir.module.category">
        <field name="name">Mobile Shop</field>
        <field name="description">Access rights for the Mobile Shop POS module.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: groups no longer link to a category directly. They link to
         a res.groups.privilege, which in turn links to the category. -->
    <record id="privilege_mobile_shop" model="res.groups.privilege">
        <field name="name">Mobile Shop</field>
        <field name="category_id" ref="module_category_mobile_shop"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_mobile_shop_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="privilege_id" ref="privilege_mobile_shop"/>
        <field name="comment">Can use the POS screen, create bills, and add stock.
Product catalog is read-only. Cannot manage categories/specifications,
cannot see the Sales Report, and cannot delete bills or stock-in
records once created.</field>
    </record>

    <record id="group_mobile_shop_manager" model="res.groups">
        <field name="name">Owner / Manager</field>
        <field name="privilege_id" ref="privilege_mobile_shop"/>
        <field name="implied_ids" eval="[(4, ref('group_mobile_shop_cashier'))]"/>
        <field name="comment">Full access: manage products, categories, specifications,
view cost price / profit, and view the Sales Report.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>