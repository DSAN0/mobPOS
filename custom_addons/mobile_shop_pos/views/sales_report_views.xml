<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="mobile_sale_report_search_view" model="ir.ui.view">
        <field name="name">mobile.sale.line.report.search</field>
        <field name="model">mobile.sale.line</field>

        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="category_id"/>

                <filter name="confirmed_only" string="Confirmed Bills Only" domain="[('state','=','confirmed')]"/>

                <separator/>

                <filter name="today" string="Today"
                        domain="[('sale_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('sale_date','&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="this_year" string="This Year"
                        domain="[('sale_date','&gt;=', context_today().strftime('%Y-01-01'))]"/>

                <separator/>

                <group>
                    <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by':'brand'}"/>
                    <filter name="group_model" string="Model" context="{'group_by':'model_name'}"/>
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by':'sale_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mobile_sale_report_pivot_view" model="ir.ui.view">
        <field name="name">mobile.sale.line.report.pivot</field>
        <field name="model">mobile.sale.line</field>

        <field name="arch" type="xml">
            <pivot>
                <field name="category_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="sale_date" type="col" interval="month"/>
                <field name="quantity" type="measure"/>
                <field name="subtotal" type="measure"/>
                <field name="cost_total" type="measure"/>
                <field name="profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="mobile_sale_report_graph_view" model="ir.ui.view">
        <field name="name">mobile.sale.line.report.graph</field>
        <field name="model">mobile.sale.line</field>

        <field name="arch" type="xml">
            <graph type="bar">
                <field name="category_id"/>
                <field name="profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="mobile_sale_report_list_view" model="ir.ui.view">
        <field name="name">mobile.sale.line.report.list</field>
        <field name="model">mobile.sale.line</field>

        <field name="arch" type="xml">
            <list>
                <field name="sale_date"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="cost_price"/>
                <field name="subtotal"/>
                <field name="cost_total"/>
                <field name="profit"/>
            </list>
        </field>
    </record>

    <record id="mobile_sale_report_action" model="ir.actions.act_window">
        <field name="name">Sales Report</field>
        <field name="res_model">mobile.sale.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="mobile_sale_report_search_view"/>
        <field name="context">{'search_default_confirmed_only': 1, 'search_default_group_category': 1, 'search_default_group_product': 1}</field>
    </record>

    <menuitem
        id="mobile_sale_report_menu"
        name="Sales Report"
        parent="mobile_shop_menu_root"
        action="mobile_shop_pos.mobile_sales_report_screen_action"
        groups="mobile_shop_pos.group_mobile_shop_manager"
        sequence="30"/>

</odoo>