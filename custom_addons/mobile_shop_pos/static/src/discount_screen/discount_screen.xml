<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mobile_shop_pos.DiscountScreen">
        <div class="o_mobile_pos o_mobile_discount_screen">

            <div class="o_mobile_pos_products">

                <!-- Topbar -->
                <div class="o_mobile_pos_topbar">
                    <div class="o_mobile_pos_brand">
                        <div class="o_mobile_pos_brand_icon o_mobile_brand_icon_discount">
                            <i class="fa fa-tags" role="img"/>
                        </div>
                        <div class="o_mobile_pos_brand_text">
                            <span class="o_mobile_pos_brand_title">Discount Deals</span>
                            <span class="o_mobile_pos_brand_sub">Promotions &amp; Special Prices</span>
                        </div>
                    </div>


                    <div class="o_mobile_pos_search">
                        <i class="fa fa-search"/>
                        <input type="text"
                               placeholder="Search discounted items, brands, models..."
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"/>
                        <i t-if="state.searchTerm"
                           class="fa fa-times o_mobile_pos_search_clear"
                           title="Clear search"
                           t-on-click="clearSearch"/>
                    </div>

                    <button type="button"
                            t-att-class="'o_mobile_discount_toggle_btn ' + (state.onlyDiscounted ? 'active' : '')"
                            t-on-click="toggleOnlyDiscounted">
                        <i class="fa fa-tag"/>
                        <span><t t-esc="state.onlyDiscounted ? 'Showing On Sale Only' : 'Show On Sale Only'"/></span>
                    </button>
                </div>

                <div t-if="!state.isManager" class="o_mobile_discount_readonly_note">
                    <i class="fa fa-info-circle"/> Viewing mode only. Please ask a Manager or Store Owner to configure discounts.
                </div>

                <!-- Main Catalog Layout with Cascading Scrollable Navigation Panels -->
                <div class="o_mobile_pos_catalog_layout">

                    <!-- Panel 1: Categories Side Navigation -->
                    <div class="o_mobile_nav_pane o_mobile_pane_categories">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Categories</span>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <t t-foreach="categoryList" t-as="cat" t-key="cat.id || 'all'">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeCategory === cat.id ? 'active' : '')"
                                        t-on-click="() => this.setCategory(cat.id)">
                                    <div class="o_mobile_nav_item_icon">
                                        <i t-att-class="'fa ' + cat.icon"/>
                                    </div>
                                    <span class="o_mobile_nav_item_name" t-esc="cat.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="cat.count"/>
                                    <i t-if="cat.id !== null" class="fa fa-chevron-right o_mobile_nav_item_arrow"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Panel 2: Brands Sub-pane -->
                    <div t-if="state.activeCategory !== null &amp;&amp; availableBrands.length"
                         class="o_mobile_nav_pane o_mobile_pane_brands">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Brands</span>
                            <button t-if="state.activeBrand"
                                    type="button"
                                    class="o_mobile_pane_clear_btn"
                                    t-on-click="clearBrand">All</button>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <button type="button"
                                    t-att-class="'o_mobile_nav_item ' + (state.activeBrand === null ? 'active' : '')"
                                    t-on-click="clearBrand">
                                <span class="o_mobile_nav_item_name">All Brands</span>
                            </button>
                            <t t-foreach="availableBrands" t-as="brand" t-key="brand.name">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeBrand === brand.name ? 'active' : '')"
                                        t-on-click="() => this.setBrand(brand.name)">
                                    <span class="o_mobile_nav_item_name" t-esc="brand.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="brand.count"/>
                                    <i class="fa fa-chevron-right o_mobile_nav_item_arrow"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Panel 3: Models Sub-pane -->
                    <div t-if="state.activeBrand &amp;&amp; availableModels.length"
                         class="o_mobile_nav_pane o_mobile_pane_models">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Models</span>
                            <button t-if="state.activeModel"
                                    type="button"
                                    class="o_mobile_pane_clear_btn"
                                    t-on-click="clearModel">All</button>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <button type="button"
                                    t-att-class="'o_mobile_nav_item ' + (state.activeModel === null ? 'active' : '')"
                                    t-on-click="clearModel">
                                <span class="o_mobile_nav_item_name">All Models</span>
                            </button>
                            <t t-foreach="availableModels" t-as="model" t-key="model.name">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeModel === model.name ? 'active' : '')"
                                        t-on-click="() => this.setModel(model.name)">
                                    <span class="o_mobile_nav_item_name" t-esc="model.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="model.count"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Products Grid Content Area -->
                    <div class="o_mobile_catalog_content">

                        <!-- Breadcrumbs bar -->
                        <div class="o_mobile_filter_breadcrumb">
                            <div class="o_mobile_breadcrumb_trail">
                                <span class="o_mobile_crumb" t-on-click="resetAllFilters">
                                    <i class="fa fa-home"/> Deals
                                </span>
                                <t t-if="state.activeCategory !== null">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active" t-esc="activeCategoryName"/>
                                </t>
                                <t t-if="state.activeBrand">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active">
                                        <t t-esc="state.activeBrand"/>
                                        <i class="fa fa-times o_mobile_crumb_remove" t-on-click.stop="clearBrand"/>
                                    </span>
                                </t>
                                <t t-if="state.activeModel">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active">
                                        <t t-esc="state.activeModel"/>
                                        <i class="fa fa-times o_mobile_crumb_remove" t-on-click.stop="clearModel"/>
                                    </span>
                                </t>
                            </div>

                            <div class="o_mobile_catalog_count">
                                <span t-esc="filteredProducts.length"/> products
                            </div>
                        </div>

                        <!-- Products Grid -->
                        <div class="o_mobile_pos_grid_wrapper">
                            <div t-if="state.loading" class="o_mobile_pos_loading">
                                <i class="fa fa-circle-o-notch fa-spin"/>
                                <span>Loading discounted products...</span>
                            </div>

                            <div t-elif="!filteredProducts.length" class="o_mobile_pos_empty">
                                <div class="o_mobile_pos_empty_icon">
                                    <i class="fa fa-tag"/>
                                </div>
                                <div class="o_mobile_pos_empty_title">No products found</div>
                                <div class="o_mobile_pos_empty_desc">No items match your filter criteria or search query.</div>
                                <button type="button" class="o_mobile_pos_empty_btn" t-on-click="resetAllFilters">
                                    Show All Products
                                </button>
                            </div>

                            <div t-else="" class="o_mobile_pos_grid">
                                <t t-foreach="filteredProducts" t-as="product" t-key="product.id">
                                    <div class="o_mobile_pos_card o_mobile_discount_card"
                                         t-att-class="state.isManager ? '' : 'o_mobile_discount_card_static'"
                                         t-on-click="() => this.openEdit(product)">

                                        <div class="o_mobile_pos_card_img">
                                            <img t-att-src="productImageUrl(product)" alt="product" loading="lazy"/>
                                            <span t-if="product.has_discount"
                                                  class="o_mobile_pos_card_sale_badge">
                                                -<t t-esc="Math.round(product.discount_percent)"/>% OFF
                                            </span>
                                            <span t-else="" class="o_mobile_no_discount_badge">
                                                Standard Price
                                            </span>
                                            <button t-if="state.isManager"
                                                    type="button"
                                                    class="o_mobile_card_action_btn"
                                                    title="Edit Discount"
                                                    t-on-click.stop="() => this.openEdit(product)">
                                                <i class="fa fa-pencil"/>
                                            </button>
                                        </div>

                                        <div class="o_mobile_pos_card_body">
                                            <div class="o_mobile_pos_card_name" t-esc="product.name"/>
                                            <div t-if="productSubtitle(product)"
                                                 class="o_mobile_pos_card_sub"
                                                 t-esc="productSubtitle(product)"/>
                                            
                                            <div class="o_mobile_pos_card_footer">
                                                <div class="o_mobile_pos_card_price_box">
                                                    <span t-if="product.has_discount" class="o_mobile_pos_card_price_wrap">
                                                        <span class="o_mobile_pos_card_price_old">
                                                            LKR <t t-esc="formatMoney(product.selling_price)"/>
                                                        </span>
                                                        <span class="o_mobile_pos_card_price o_mobile_pos_card_price_sale">
                                                            LKR <t t-esc="formatMoney(product.discount_price)"/>
                                                        </span>
                                                    </span>
                                                    <span t-else="" class="o_mobile_pos_card_price">
                                                        LKR <t t-esc="formatMoney(product.selling_price)"/>
                                                    </span>
                                                </div>
                                                <span class="o_mobile_pos_card_stock">
                                                    <t t-esc="product.stock_quantity"/> in stock
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- ============ MANAGER-ONLY: SET DISCOUNT DRAWER ============ -->
            <t t-if="state.isManager">
                <div t-if="state.panelOpen" class="o_mobile_products_overlay" t-on-click="closePanel"/>

                <div t-att-class="'o_mobile_products_panel o_mobile_discount_panel ' + (state.panelOpen ? 'open' : '')">
                    <div class="o_mobile_products_panel_header">
                        <div class="o_mobile_drawer_title">
                            <i class="fa fa-tag"/>
                            <span>Configure Discount</span>
                        </div>
                        <button type="button" class="o_mobile_products_panel_close" t-on-click="closePanel">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="o_mobile_products_panel_body">
                        <div class="o_mobile_discount_product_card">
                            <span class="o_mobile_discount_label">Product</span>
                            <span class="o_mobile_discount_product_name" t-esc="state.form.name"/>
                        </div>

                        <div class="o_mobile_products_field">
                            <label>Regular Selling Price</label>
                            <input type="text" t-att-value="'LKR ' + formatMoney(state.form.selling_price)" disabled="disabled"/>
                        </div>

                        <div class="o_mobile_products_field">
                            <label>Special Discount Price <span class="o_mobile_products_hint">(Enter 0 to remove discount)</span></label>
                            <input type="number" step="0.01" min="0"
                                   placeholder="0.00"
                                   t-att-value="state.form.discount_price"
                                   t-on-input="onDiscountPriceInput"/>
                        </div>

                        <div t-if="previewPercent &gt; 0" class="o_mobile_discount_preview_card">
                            <div class="o_mobile_preview_icon">
                                <i class="fa fa-percent"/>
                            </div>
                            <div class="o_mobile_preview_text">
                                <span class="o_mobile_preview_title"><t t-esc="Math.round(previewPercent)"/>% Discount Applied!</span>
                                <span class="o_mobile_preview_saving">
                                    Customer saves LKR <t t-esc="formatMoney(state.form.selling_price - state.form.discount_price)"/> per item
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="o_mobile_products_panel_footer">
                        <button type="button"
                                class="o_mobile_products_delete_btn"
                                t-on-click="clearDiscount">
                            <i class="fa fa-times"/> Remove Discount
                        </button>
                        <button type="button"
                                class="o_mobile_products_save_btn"
                                t-att-disabled="state.saving"
                                t-on-click="saveDiscount">
                            <i t-if="state.saving" class="fa fa-circle-o-notch fa-spin"/>
                            <t t-if="!state.saving">Save Discount</t>
                            <t t-else="">Saving...</t>
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
