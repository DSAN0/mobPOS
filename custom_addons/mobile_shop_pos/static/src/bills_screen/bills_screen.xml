<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mobile_shop_pos.BillsScreen">
        <div class="o_mobile_pos o_mobile_bills_screen">

            <div class="o_mobile_pos_products">

                <div class="o_mobile_pos_topbar">
                    <div class="o_mobile_pos_brand">
                        <i class="fa fa-file-text-o" role="img"/>
                        <span>See Bills</span>
                    </div>

                    <div class="o_mobile_pos_search">
                        <i class="fa fa-search"/>
                        <input type="text"
                               placeholder="Search bill no..."
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"/>
                        <i t-if="state.searchTerm"
                           class="fa fa-times o_mobile_pos_search_clear"
                           t-on-click="clearSearch"/>
                    </div>
                </div>

                <div class="o_mobile_pos_categories">
                    <t t-foreach="dateFilters" t-as="df" t-key="df.key">
                        <button type="button"
                                t-att-class="'o_mobile_pos_cat_btn ' + (state.dateFilter === df.key ? 'active' : '')"
                                t-on-click="() => this.setDateFilter(df.key)">
                            <t t-esc="df.label"/>
                        </button>
                    </t>
                </div>

                <div class="o_mobile_pos_categories">
                    <t t-foreach="statusFilters" t-as="sf" t-key="sf.key">
                        <button type="button"
                                t-att-class="'o_mobile_pos_cat_btn ' + (state.statusFilter === sf.key ? 'active' : '')"
                                t-on-click="() => this.setStatusFilter(sf.key)">
                            <t t-esc="sf.label"/>
                        </button>
                    </t>
                </div>

                <div class="o_mobile_report_summary">
                    <div class="o_mobile_report_card">
                        <span class="o_mobile_report_card_label">Bills</span>
                        <span class="o_mobile_report_card_value"><t t-esc="summary.count"/></span>
                    </div>
                    <div class="o_mobile_report_card">
                        <span class="o_mobile_report_card_label">Revenue</span>
                        <span class="o_mobile_report_card_value">LKR <t t-esc="formatMoney(summary.revenue)"/></span>
                    </div>
                    <div class="o_mobile_report_card o_mobile_report_card_profit">
                        <span class="o_mobile_report_card_label">Discount Given</span>
                        <span class="o_mobile_report_card_value">LKR <t t-esc="formatMoney(summary.discount)"/></span>
                    </div>
                </div>

                <div class="o_mobile_pos_grid_wrapper">
                    <div t-if="state.loading" class="o_mobile_pos_loading">
                        <i class="fa fa-circle-o-notch fa-spin"/> Loading bills...
                    </div>

                    <div t-elif="!filteredBills.length" class="o_mobile_pos_empty">
                        <i class="fa fa-inbox"/>
                        <div>No bills found</div>
                    </div>

                    <table t-else="" class="o_mobile_report_table o_mobile_bills_table">
                        <thead>
                            <tr>
                                <th>Bill No</th>
                                <th>Date</th>
                                <th>Payment</th>
                                <th>Served By</th>
                                <th class="text-end">Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="filteredBills" t-as="bill" t-key="bill.id">
                                <tr t-att-class="bill.state === 'cancelled' ? 'o_mobile_bill_row_cancelled' : ''"
                                    t-on-click="() => this.openBill(bill)">
                                    <td class="o_mobile_report_row_name"><t t-esc="bill.name"/></td>
                                    <td><t t-esc="bill.sale_date"/></td>
                                    <td><t t-esc="paymentLabel(bill.payment_method)"/></td>
                                    <td><t t-esc="bill.cashier_id ? bill.cashier_id[1] : '—'"/></td>
                                    <td class="text-end">LKR <t t-esc="formatMoney(bill.total_amount)"/></td>
                                    <td>
                                        <span t-att-class="'o_mobile_bill_status o_mobile_bill_status_' + bill.state">
                                            <t t-esc="statusLabel(bill.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Bill Detail Panel -->
            <div t-if="state.panelOpen" class="o_mobile_products_overlay" t-on-click="closePanel"/>

            <div t-att-class="'o_mobile_products_panel o_mobile_bill_panel ' + (state.panelOpen ? 'open' : '')">
                <div class="o_mobile_products_panel_header">
                    <span>Bill <t t-if="state.detail" t-esc="state.detail.name"/></span>
                    <button type="button" class="o_mobile_products_panel_close" t-on-click="closePanel">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <div class="o_mobile_products_panel_body" t-if="state.detail">
                    <div class="o_mobile_bill_meta">
                        <div class="o_mobile_bill_meta_row">
                            <label>Date</label>
                            <span t-esc="state.detail.sale_date"/>
                        </div>
                        <div class="o_mobile_bill_meta_row">
                            <label>Payment</label>
                            <span t-esc="paymentLabel(state.detail.payment_method)"/>
                        </div>
                        <div class="o_mobile_bill_meta_row" t-if="state.detail.cashier_id">
                            <label>Served By</label>
                            <span t-esc="state.detail.cashier_id[1]"/>
                        </div>
                        <div class="o_mobile_bill_meta_row">
                            <label>Status</label>
                            <span t-att-class="'o_mobile_bill_status o_mobile_bill_status_' + state.detail.state"
                                  t-esc="statusLabel(state.detail.state)"/>
                        </div>
                    </div>

                    <div t-if="state.detailLoading" class="o_mobile_pos_loading">
                        <i class="fa fa-circle-o-notch fa-spin"/> Loading items...
                    </div>

                    <table t-else="" class="o_mobile_report_table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.detailLines" t-as="line" t-key="line.id">
                                <tr>
                                    <td><t t-esc="line.product_id[1]"/></td>
                                    <td class="text-end"><t t-esc="line.quantity"/></td>
                                    <td class="text-end">LKR <t t-esc="formatMoney(line.price)"/></td>
                                    <td class="text-end">LKR <t t-esc="formatMoney(line.subtotal)"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="o_mobile_pos_totals">
                        <div class="o_mobile_pos_total_row">
                            <span>Subtotal</span>
                            <span>LKR <t t-esc="formatMoney(state.detail.amount_before_discount)"/></span>
                        </div>
                        <div class="o_mobile_pos_total_row" t-if="state.detail.total_discount">
                            <span>Discount</span>
                            <span>-LKR <t t-esc="formatMoney(state.detail.total_discount)"/></span>
                        </div>
                        <div class="o_mobile_pos_total_row o_mobile_pos_total_main">
                            <span>Total</span>
                            <span>LKR <t t-esc="formatMoney(state.detail.total_amount)"/></span>
                        </div>
                        <t t-if="state.detail.payment_method === 'cash'">
                            <div class="o_mobile_pos_total_row">
                                <span>Tendered</span>
                                <span>LKR <t t-esc="formatMoney(state.detail.amount_tendered)"/></span>
                            </div>
                            <div class="o_mobile_pos_total_row">
                                <span>Change</span>
                                <span>LKR <t t-esc="formatMoney(state.detail.change_due)"/></span>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="o_mobile_products_panel_footer" t-if="state.detail">
                    <button type="button"
                            class="o_mobile_products_save_btn"
                            t-if="state.detail.state === 'confirmed'"
                            t-on-click="printReceipt">
                        <i class="fa fa-print"/> Print Receipt
                    </button>
                    <button type="button"
                            class="o_mobile_products_delete_btn"
                            t-if="state.isManager and state.detail.state === 'confirmed'"
                            t-att-disabled="state.cancelling"
                            t-on-click="cancelBill">
                        <i class="fa fa-ban"/> Cancel Bill
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
