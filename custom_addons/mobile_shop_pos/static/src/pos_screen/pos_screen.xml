<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mobile_shop_pos.POSScreen">
        <div class="o_mobile_pos">

            <!-- ============ LEFT: PRODUCTS & HIERARCHICAL DRILL-DOWN ============ -->
            <div class="o_mobile_pos_products">

                <!-- Topbar -->
                <div class="o_mobile_pos_topbar">
                    <div class="o_mobile_pos_brand">
                        <div class="o_mobile_pos_brand_icon">
                            <i class="fa fa-mobile" role="img"/>
                        </div>
                        <div class="o_mobile_pos_brand_text">
                            <span class="o_mobile_pos_brand_title">Mobile Shop</span>
                            <span class="o_mobile_pos_brand_sub">POS Terminal</span>
                        </div>
                    </div>


                    <div class="o_mobile_pos_search">
                        <i class="fa fa-search"/>
                        <input type="text"
                               placeholder="Search products, brand, model, specs..."
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"/>
                        <i t-if="state.searchTerm"
                           class="fa fa-times o_mobile_pos_search_clear"
                           title="Clear search"
                           t-on-click="clearSearch"/>
                    </div>

                    <div class="o_mobile_pos_user_chip">
                        <i class="fa fa-user-circle"/>
                        <span t-esc="userName"/>
                    </div>

                    <button type="button" class="o_mobile_pos_logout_btn" t-on-click="logOut">
                        <i class="fa fa-sign-out"/> Log Out
                    </button>
                </div>

                <!-- Barcode Scan Bar -->
                <div class="o_mobile_scan_bar">
                    <div class="o_mobile_scan_icon">
                        <i class="fa fa-barcode"/>
                    </div>
                    <input type="text"
                           t-ref="scanInput"
                           placeholder="Scan barcode or press Enter to add instantly..."
                           t-att-value="state.scanTerm"
                           t-on-input="onScanInput"
                           t-on-keydown="onScanKeydown"/>
                    <div class="o_mobile_scan_badge_group">
                        <span class="o_mobile_scan_kbd_hint"><i class="fa fa-level-down fa-rotate-90"/> Enter</span>
                        <span class="o_mobile_scan_badge">
                            <span class="o_mobile_scan_dot"/>
                            Scanner Ready
                        </span>
                    </div>
                </div>

                <!-- Main Catalog Container with Cascading Hierarchical Panels -->
                <div class="o_mobile_pos_catalog_layout">

                    <!-- Panel 1: Categories Side Navigation -->
                    <div class="o_mobile_nav_pane o_mobile_pane_categories">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Categories</span>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <t t-foreach="categoryList" t-as="cat" t-key="cat.id || 'all'">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeCategory === cat.id ? 'active' : '')"
                                        t-on-click="() => this.setCategory(cat.id)">
                                    <div class="o_mobile_nav_item_icon">
                                        <i t-att-class="'fa ' + cat.icon"/>
                                    </div>
                                    <span class="o_mobile_nav_item_name" t-esc="cat.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="cat.count"/>
                                    <i t-if="cat.id !== null" class="fa fa-chevron-right o_mobile_nav_item_arrow"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Panel 2: Brands Sub-pane (Slides open beside Category) -->
                    <div t-if="state.activeCategory !== null &amp;&amp; availableBrands.length"
                         class="o_mobile_nav_pane o_mobile_pane_brands">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Brands</span>
                            <button t-if="state.activeBrand"
                                    type="button"
                                    class="o_mobile_pane_clear_btn"
                                    t-on-click="clearBrand">All</button>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <button type="button"
                                    t-att-class="'o_mobile_nav_item ' + (state.activeBrand === null ? 'active' : '')"
                                    t-on-click="clearBrand">
                                <span class="o_mobile_nav_item_name">All Brands</span>
                            </button>
                            <t t-foreach="availableBrands" t-as="brand" t-key="brand.name">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeBrand === brand.name ? 'active' : '')"
                                        t-on-click="() => this.setBrand(brand.name)">
                                    <span class="o_mobile_nav_item_name" t-esc="brand.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="brand.count"/>
                                    <i class="fa fa-chevron-right o_mobile_nav_item_arrow"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Panel 3: Models Sub-pane (Slides open beside Brand) -->
                    <div t-if="state.activeBrand &amp;&amp; availableModels.length"
                         class="o_mobile_nav_pane o_mobile_pane_models">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Models</span>
                            <button t-if="state.activeModel"
                                    type="button"
                                    class="o_mobile_pane_clear_btn"
                                    t-on-click="clearModel">All</button>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <button type="button"
                                    t-att-class="'o_mobile_nav_item ' + (state.activeModel === null ? 'active' : '')"
                                    t-on-click="clearModel">
                                <span class="o_mobile_nav_item_name">All Models</span>
                            </button>
                            <t t-foreach="availableModels" t-as="model" t-key="model.name">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeModel === model.name ? 'active' : '')"
                                        t-on-click="() => this.setModel(model.name)">
                                    <span class="o_mobile_nav_item_name" t-esc="model.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="model.count"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Products Grid Content Area -->
                    <div class="o_mobile_catalog_content">

                        <!-- Breadcrumb / Active Filters Strip -->
                        <div class="o_mobile_filter_breadcrumb">
                            <div class="o_mobile_breadcrumb_trail">
                                <span class="o_mobile_crumb" t-on-click="resetAllFilters">
                                    <i class="fa fa-home"/> Catalog
                                </span>
                                <t t-if="state.activeCategory !== null">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active" t-esc="activeCategoryName"/>
                                </t>
                                <t t-if="state.activeBrand">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active">
                                        <t t-esc="state.activeBrand"/>
                                        <i class="fa fa-times o_mobile_crumb_remove" t-on-click.stop="clearBrand"/>
                                    </span>
                                </t>
                                <t t-if="state.activeModel">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active">
                                        <t t-esc="state.activeModel"/>
                                        <i class="fa fa-times o_mobile_crumb_remove" t-on-click.stop="clearModel"/>
                                    </span>
                                </t>
                            </div>

                            <div class="o_mobile_catalog_count">
                                <span t-esc="filteredProducts.length"/> products
                            </div>
                        </div>

                        <!-- Grid -->
                        <div class="o_mobile_pos_grid_wrapper">
                            <div t-if="state.loading" class="o_mobile_pos_loading">
                                <i class="fa fa-circle-o-notch fa-spin"/>
                                <span>Loading products...</span>
                            </div>

                            <div t-elif="!filteredProducts.length" class="o_mobile_pos_empty">
                                <div class="o_mobile_pos_empty_icon">
                                    <i class="fa fa-cube"/>
                                </div>
                                <div class="o_mobile_pos_empty_title">No products found</div>
                                <div class="o_mobile_pos_empty_desc">Try selecting a different category or clearing search filters.</div>
                                <button type="button" class="o_mobile_pos_empty_btn" t-on-click="resetAllFilters">
                                    Show All Products
                                </button>
                            </div>

                            <div t-else="" class="o_mobile_pos_grid">
                                <t t-foreach="filteredProducts" t-as="product" t-key="product.id">
                                    <div class="o_mobile_pos_card"
                                         t-att-class="product.stock_quantity &lt;= 0 ? 'out_of_stock' : ''"
                                         t-on-click="() => this.addToCart(product)">

                                        <div class="o_mobile_pos_card_img">
                                            <img t-att-src="productImageUrl(product)" alt="product" loading="lazy"/>
                                            <span t-if="cartQtyFor(product.id)"
                                                  class="o_mobile_pos_card_badge">
                                                <t t-esc="cartQtyFor(product.id)"/>
                                            </span>
                                            <span t-if="product.is_low_stock &amp;&amp; product.stock_quantity &gt; 0"
                                                  class="o_mobile_pos_card_low_badge">Low Stock</span>
                                            <span t-if="product.has_discount"
                                                  class="o_mobile_pos_card_sale_badge">
                                                -<t t-esc="Math.round(product.discount_percent)"/>% OFF
                                            </span>
                                            <button type="button"
                                                    class="o_mobile_pos_card_quick_info"
                                                    title="View Details"
                                                    t-on-click.stop="() => this.openDetails(product)">
                                                <i class="fa fa-info"/>
                                            </button>
                                        </div>

                                        <div class="o_mobile_pos_card_body">
                                            <div class="o_mobile_pos_card_name" t-esc="product.name"/>
                                            <div t-if="productSubtitle(product)"
                                                 class="o_mobile_pos_card_sub"
                                                 t-esc="productSubtitle(product)"/>
                                            
                                            <div class="o_mobile_pos_card_footer">
                                                <div class="o_mobile_pos_card_price_box">
                                                    <span t-if="product.has_discount" class="o_mobile_pos_card_price_wrap">
                                                        <span class="o_mobile_pos_card_price_old">
                                                            LKR <t t-esc="formatMoney(product.selling_price)"/>
                                                        </span>
                                                        <span class="o_mobile_pos_card_price o_mobile_pos_card_price_sale">
                                                            LKR <t t-esc="formatMoney(product.discount_price)"/>
                                                        </span>
                                                    </span>
                                                    <span t-else="" class="o_mobile_pos_card_price">
                                                        LKR <t t-esc="formatMoney(product.selling_price)"/>
                                                    </span>
                                                </div>
                                                <span class="o_mobile_pos_card_stock">
                                                    <t t-esc="product.stock_quantity"/> left
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- ============ RIGHT: CURRENT ORDER / BILL (MATCHING SCREENSHOT) ============ -->
            <div class="o_mobile_pos_cart">

                <!-- Header: "Current Order" + "X items" badge -->
                <div class="o_mobile_pos_cart_header">
                    <span class="o_mobile_pos_order_title">Current Order</span>
                    <span class="o_mobile_pos_items_badge">
                        <t t-esc="cartCount"/> items
                    </span>
                </div>

                <!-- Order Content: Empty State Box or Cart Items List -->
                <div class="o_mobile_pos_order_content">
                    
                    <!-- Empty State Box (styled exactly like screenshot) -->
                    <div t-if="!state.cart.length" class="o_mobile_pos_order_empty_card">
                        <p>Scan or tap a product to start the order.</p>
                    </div>

                    <!-- Cart Lines -->
                    <div t-else="" class="o_mobile_pos_cart_lines_list">
                        <t t-foreach="state.cart" t-as="line" t-key="line.productId">
                            <div class="o_mobile_pos_line">
                                <div class="o_mobile_pos_line_info">
                                    <div class="o_mobile_pos_line_name" t-esc="line.name"/>
                                    <div t-if="line.hasDiscount" class="o_mobile_pos_line_sub o_mobile_pos_line_discount_sub">
                                        <span class="o_mobile_pos_line_price_old">
                                            LKR <t t-esc="formatMoney(line.listPrice)"/>
                                        </span>
                                        <span>LKR <t t-esc="formatMoney(line.price)"/></span>
                                        <span class="o_mobile_pos_line_discount_chip">
                                            -<t t-esc="Math.round(line.discountPercent)"/>%
                                        </span>
                                    </div>
                                    <div t-else="" class="o_mobile_pos_line_sub">
                                        LKR <t t-esc="formatMoney(line.price)"/>
                                    </div>
                                </div>

                                <div class="o_mobile_pos_line_qty">
                                    <button type="button" class="o_mobile_qty_btn" t-on-click="() => this.decrementLine(line)">-</button>
                                    <input type="number"
                                           min="1"
                                           class="o_mobile_qty_input"
                                           t-att-value="line.qty"
                                           t-on-change="(ev) => this.onLineQtyInput(line, ev)"/>
                                    <button type="button" class="o_mobile_qty_btn" t-on-click="() => this.incrementLine(line)">+</button>
                                </div>

                                <div class="o_mobile_pos_line_amount">
                                    <t t-esc="formatMoney(line.qty * line.price)"/>
                                </div>

                                <button type="button"
                                        class="o_mobile_pos_line_remove"
                                        title="Remove item"
                                        t-on-click="() => this.removeLine(line)">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </t>
                    </div>

                </div>

                <!-- Separator Dotted Line -->
                <div class="o_mobile_pos_order_divider"/>

                <!-- Totals Section -->
                <div class="o_mobile_pos_totals_block">
                    <div class="o_mobile_pos_total_row o_mobile_pos_subtotal_row">
                        <span>Subtotal</span>
                        <span><t t-esc="formatMoney(subtotalBeforeDiscount)"/></span>
                    </div>
                    <div class="o_mobile_pos_total_row o_mobile_pos_discount_row">
                        <span>Discount</span>
                        <span>- <t t-esc="formatMoney(totalDiscount)"/></span>
                    </div>
                    <div class="o_mobile_pos_total_row o_mobile_pos_grand_total_row">
                        <span>Total</span>
                        <span><t t-esc="formatMoney(total)"/></span>
                    </div>
                </div>

                <!-- Payment Method Segmented Control (Pill Tabs) -->
                <div class="o_mobile_pos_payment_segmented">
                    <button type="button"
                            t-att-class="'o_mobile_pos_segment_btn ' + (state.paymentMethod === 'cash' ? 'active' : '')"
                            t-on-click="() => this.setPaymentMethod('cash')">
                        Cash
                    </button>
                    <button type="button"
                            t-att-class="'o_mobile_pos_segment_btn ' + (state.paymentMethod === 'card' ? 'active' : '')"
                            t-on-click="() => this.setPaymentMethod('card')">
                        Card
                    </button>
                    <button type="button"
                            t-att-class="'o_mobile_pos_segment_btn ' + (state.paymentMethod === 'online' ? 'active' : '')"
                            t-on-click="() => this.setPaymentMethod('online')">
                        Online
                    </button>
                </div>

                <!-- Tendered & Change Row -->
                <div class="o_mobile_pos_tendered_row">
                    <div class="o_mobile_pos_tendered_input_group">
                        <label>Tendered</label>
                        <input type="text"
                               t-ref="tenderedInput"
                               class="o_mobile_tendered_field"
                               t-att-value="state.tenderedInputStr"
                               t-att-disabled="state.paymentMethod !== 'cash'"
                               t-on-input="onTenderedInput"
                               t-on-focus="onTenderedFocus"
                               t-on-blur="onTenderedBlur"/>
                        <button t-if="state.paymentMethod === 'cash' &amp;&amp; state.cart.length"
                                type="button"
                                class="o_mobile_exact_btn"
                                title="Exact Amount"
                                t-on-click="setExactTendered">
                            Exact
                        </button>
                    </div>

                    <div class="o_mobile_pos_change_group"
                         t-att-class="changeDue &lt; 0 ? 'negative' : 'positive'">
                        <span>Change <t t-esc="formatMoney(changeDue &gt; 0 ? changeDue : 0)"/></span>
                    </div>
                </div>

                <!-- Bottom Actions: Clear (lavender) + Charge (vibrant gradient) -->
                <div class="o_mobile_pos_cart_actions">
                    <button type="button"
                            class="o_mobile_pos_clear_order_btn"
                            t-att-disabled="!state.cart.length"
                            t-on-click="clearCart">
                        Clear
                    </button>

                    <button type="button"
                            class="o_mobile_pos_charge_btn"
                            t-att-disabled="!state.cart.length || state.processing"
                            t-on-click="confirmSale">
                        <i t-if="state.processing" class="fa fa-circle-o-notch fa-spin"/>
                        <t t-if="!state.processing">
                            Charge <t t-esc="formatMoney(total)"/>
                        </t>
                        <t t-else="">Processing...</t>
                    </button>
                </div>

            </div>

            <!-- ============ PRODUCT DETAILS OVERLAY MODAL ============ -->
            <div t-if="state.detailsProduct" class="o_mobile_pos_details_overlay" t-on-click="closeDetails">
                <div class="o_mobile_pos_details_panel" t-on-click.stop="() => {}">

                    <button type="button" class="o_mobile_pos_details_close" t-on-click="closeDetails">
                        <i class="fa fa-times"/>
                    </button>

                    <div class="o_mobile_pos_details_img">
                        <img t-att-src="productImageUrl(state.detailsProduct)" alt="product"/>
                    </div>

                    <div class="o_mobile_pos_details_body">
                        <div class="o_mobile_pos_details_name" t-esc="state.detailsProduct.name"/>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.category_id">
                            <span class="o_mobile_pos_details_label">Category</span>
                            <span class="o_mobile_pos_details_val" t-esc="state.detailsProduct.category_id[1]"/>
                        </div>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.brand">
                            <span class="o_mobile_pos_details_label">Brand</span>
                            <span class="o_mobile_pos_details_val" t-esc="state.detailsProduct.brand"/>
                        </div>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.model_name">
                            <span class="o_mobile_pos_details_label">Model</span>
                            <span class="o_mobile_pos_details_val" t-esc="state.detailsProduct.model_name"/>
                        </div>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.spec_summary">
                            <span class="o_mobile_pos_details_label">Specifications</span>
                            <span class="o_mobile_pos_details_val" t-esc="state.detailsProduct.spec_summary"/>
                        </div>

                        <div class="o_mobile_pos_details_row">
                            <span class="o_mobile_pos_details_label">Warranty</span>
                            <span t-if="state.detailsProduct.warranty" class="o_mobile_pos_details_val" t-esc="state.detailsProduct.warranty"/>
                            <span t-if="!state.detailsProduct.warranty" class="o_mobile_pos_details_none">No warranty</span>
                        </div>

                        <div class="o_mobile_pos_details_row">
                            <span class="o_mobile_pos_details_label">In Stock</span>
                            <span class="o_mobile_pos_details_val o_mobile_pos_stock_tag" t-esc="state.detailsProduct.stock_quantity + ' available'"/>
                        </div>

                        <div t-if="state.detailsProduct.has_discount" class="o_mobile_pos_details_price_wrap">
                            <span class="o_mobile_pos_details_price_old">
                                LKR <t t-esc="formatMoney(state.detailsProduct.selling_price)"/>
                            </span>
                            <span class="o_mobile_pos_details_price o_mobile_pos_details_price_sale">
                                LKR <t t-esc="formatMoney(state.detailsProduct.discount_price)"/>
                            </span>
                            <span class="o_mobile_pos_details_discount_chip">
                                -<t t-esc="Math.round(state.detailsProduct.discount_percent)"/>% OFF
                            </span>
                        </div>
                        <div t-else="" class="o_mobile_pos_details_price">
                            LKR <t t-esc="formatMoney(state.detailsProduct.selling_price)"/>
                        </div>

                        <button type="button"
                                class="o_mobile_pos_details_add_btn"
                                t-att-disabled="state.detailsProduct.stock_quantity &lt;= 0"
                                t-on-click="() => this.addToCartFromDetails(state.detailsProduct)">
                            <i class="fa fa-cart-plus"/> Add to Bill
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </t>

</templates>