<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mobile_shop_pos.POSScreen">
        <div class="o_mobile_pos">

            <!-- ============ LEFT: PRODUCTS ============ -->
            <div class="o_mobile_pos_products">

                <div class="o_mobile_pos_topbar">
                    <div class="o_mobile_pos_brand">
                        <i class="fa fa-mobile" role="img"/>
                        <span>Mobile Shop</span>
                    </div>

                    <div class="o_mobile_pos_search">
                        <i class="fa fa-search"/>
                        <input type="text"
                               placeholder="Search products, brand, model..."
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"/>
                        <i t-if="state.searchTerm"
                           class="fa fa-times o_mobile_pos_search_clear"
                           t-on-click="clearSearch"/>
                    </div>
                </div>

                <div class="o_mobile_pos_categories">
                    <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                        <button type="button"
                                t-att-class="'o_mobile_pos_cat_btn ' + (state.activeCategory === cat.id ? 'active' : '')"
                                t-on-click="() => this.setCategory(cat.id)">
                            <t t-esc="cat.name"/>
                        </button>
                    </t>
                </div>

                <div class="o_mobile_pos_grid_wrapper">
                    <div t-if="state.loading" class="o_mobile_pos_loading">
                        <i class="fa fa-circle-o-notch fa-spin"/> Loading products...
                    </div>

                    <div t-elif="!filteredProducts.length" class="o_mobile_pos_empty">
                        <i class="fa fa-inbox"/>
                        <div>No products found</div>
                    </div>

                    <div t-else="" class="o_mobile_pos_grid">
                        <t t-foreach="filteredProducts" t-as="product" t-key="product.id">
                            <div class="o_mobile_pos_card"
                                 t-att-class="product.stock_quantity &lt;= 0 ? 'out_of_stock' : ''"
                                 t-on-click="() => this.addToCart(product)">

                                <div class="o_mobile_pos_card_img">
                                    <img t-att-src="productImageUrl(product)" alt="product"/>
                                    <span t-if="cartQtyFor(product.id)"
                                          class="o_mobile_pos_card_badge">
                                        <t t-esc="cartQtyFor(product.id)"/>
                                    </span>
                                    <span t-if="product.is_low_stock &amp;&amp; product.stock_quantity &gt; 0"
                                          class="o_mobile_pos_card_low_badge">Low</span>
                                    <span t-if="product.has_discount"
                                          class="o_mobile_pos_card_sale_badge">
                                        -<t t-esc="Math.round(product.discount_percent)"/>%
                                    </span>
                                </div>

                                <div class="o_mobile_pos_card_body">
                                    <div class="o_mobile_pos_card_name" t-esc="product.name"/>
                                    <div t-if="productSubtitle(product)"
                                         class="o_mobile_pos_card_sub"
                                         t-esc="productSubtitle(product)"/>
                                    <div class="o_mobile_pos_card_footer">
                                        <span t-if="product.has_discount" class="o_mobile_pos_card_price_wrap">
                                            <span class="o_mobile_pos_card_price_old">
                                                LKR <t t-esc="formatMoney(product.selling_price)"/>
                                            </span>
                                            <span class="o_mobile_pos_card_price o_mobile_pos_card_price_sale">
                                                LKR <t t-esc="formatMoney(product.discount_price)"/>
                                            </span>
                                        </span>
                                        <span t-else="" class="o_mobile_pos_card_price">
                                            LKR <t t-esc="formatMoney(product.selling_price)"/>
                                        </span>
                                        <span class="o_mobile_pos_card_stock">
                                            <t t-esc="product.stock_quantity"/> left
                                        </span>
                                    </div>
                                    <button type="button"
                                            class="o_mobile_pos_card_details_btn"
                                            t-on-click.stop="() => this.openDetails(product)">
                                        Show Details
                                    </button>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- ============ RIGHT: CART / CHECKOUT ============ -->
            <div class="o_mobile_pos_cart">

                <div class="o_mobile_pos_cart_header">
                    <span><i class="fa fa-shopping-cart"/> Current Bill</span>
                    <button type="button"
                            class="o_mobile_pos_clear_btn"
                            t-if="state.cart.length"
                            t-on-click="clearCart">
                        <i class="fa fa-trash"/> Clear
                    </button>
                </div>

                <div class="o_mobile_pos_cart_split">

                    <!-- Items list + total, beside the numpad -->
                    <div class="o_mobile_pos_cart_left">
                        <div class="o_mobile_pos_cart_lines">
                            <div t-if="!state.cart.length" class="o_mobile_pos_cart_empty">
                                <i class="fa fa-hand-pointer-o"/>
                                <div>Tap a product to add it to the bill</div>
                            </div>

                            <t t-foreach="state.cart" t-as="line" t-key="line.productId">
                                <div class="o_mobile_pos_line">
                                    <div class="o_mobile_pos_line_info">
                                        <div class="o_mobile_pos_line_name" t-esc="line.name"/>
                                        <div t-if="line.hasDiscount" class="o_mobile_pos_line_sub o_mobile_pos_line_discount_sub">
                                            <span class="o_mobile_pos_line_price_old">
                                                LKR <t t-esc="formatMoney(line.listPrice)"/>
                                            </span>
                                            LKR <t t-esc="formatMoney(line.price)"/> x <t t-esc="line.qty"/>
                                            <span class="o_mobile_pos_line_discount_chip">
                                                -<t t-esc="Math.round(line.discountPercent)"/>%
                                            </span>
                                        </div>
                                        <div t-else="" class="o_mobile_pos_line_sub">
                                            LKR <t t-esc="formatMoney(line.price)"/> x <t t-esc="line.qty"/>
                                        </div>
                                    </div>

                                    <div class="o_mobile_pos_line_qty">
                                        <button type="button" t-on-click="() => this.decrementLine(line)">-</button>
                                        <input type="number"
                                               min="1"
                                               t-att-value="line.qty"
                                               t-on-change="(ev) => this.onLineQtyInput(line, ev)"/>
                                        <button type="button" t-on-click="() => this.incrementLine(line)">+</button>
                                    </div>

                                    <div class="o_mobile_pos_line_amount">
                                        LKR <t t-esc="formatMoney(line.qty * line.price)"/>
                                    </div>

                                    <button type="button"
                                            class="o_mobile_pos_line_remove"
                                            t-on-click="() => this.removeLine(line)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>

                        <div class="o_mobile_pos_totals">
                            <t t-if="totalDiscount &gt; 0">
                                <div class="o_mobile_pos_total_row o_mobile_pos_total_sub">
                                    <span>Subtotal</span>
                                    <span>LKR <t t-esc="formatMoney(subtotalBeforeDiscount)"/></span>
                                </div>
                                <div class="o_mobile_pos_total_row o_mobile_pos_total_discount">
                                    <span>Discount</span>
                                    <span>- LKR <t t-esc="formatMoney(totalDiscount)"/></span>
                                </div>
                            </t>
                            <div class="o_mobile_pos_total_row o_mobile_pos_total_main">
                                <span>Total</span>
                                <span>LKR <t t-esc="formatMoney(total)"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- Payment + numpad -->
                    <div class="o_mobile_pos_cart_right">
                        <div class="o_mobile_pos_payment">
                            <div class="o_mobile_pos_payment_methods">
                                <button type="button"
                                        t-att-class="'o_mobile_pos_pay_btn ' + (state.paymentMethod === 'cash' ? 'active' : '')"
                                        t-on-click="() => this.setPaymentMethod('cash')">
                                    <i class="fa fa-money"/> Cash
                                </button>
                                <button type="button"
                                        t-att-class="'o_mobile_pos_pay_btn ' + (state.paymentMethod === 'card' ? 'active' : '')"
                                        t-on-click="() => this.setPaymentMethod('card')">
                                    <i class="fa fa-credit-card"/> Card
                                </button>
                                <button type="button"
                                        t-att-class="'o_mobile_pos_pay_btn ' + (state.paymentMethod === 'online' ? 'active' : '')"
                                        t-on-click="() => this.setPaymentMethod('online')">
                                    <i class="fa fa-exchange"/> Online
                                </button>
                            </div>

                            <t t-if="state.paymentMethod === 'cash'">
                                <div class="o_mobile_pos_tendered">
                                    <div class="o_mobile_pos_tendered_display">
                                        <span>Tendered</span>
                                        <span class="o_mobile_pos_tendered_amount">
                                            LKR <t t-esc="formatMoney(state.amountTendered)"/>
                                        </span>
                                    </div>
                                    <div class="o_mobile_pos_change_display"
                                         t-att-class="changeDue &lt; 0 ? 'negative' : 'positive'">
                                        <span>Change</span>
                                        <span><t t-esc="formatMoney(changeDue)"/></span>
                                    </div>
                                </div>

                                <div class="o_mobile_pos_quick_amounts">
                                    <button type="button" t-on-click="() => this.quickAmount(total)">Exact</button>
                                    <button type="button" t-on-click="() => this.quickAmount(1000)">1,000</button>
                                    <button type="button" t-on-click="() => this.quickAmount(2000)">2,000</button>
                                    <button type="button" t-on-click="() => this.quickAmount(5000)">5,000</button>
                                </div>

                                <div class="o_mobile_pos_numpad">
                                    <t t-foreach="quickKeys" t-as="key" t-key="key">
                                        <button type="button"
                                                t-att-class="'o_mobile_pos_numkey' + (key === '&lt;' ? ' o_mobile_pos_numkey_back' : '')"
                                                t-on-click="() => this.pressKey(key)">
                                            <t t-if="key === '&lt;'"><i class="fa fa-long-arrow-left"/></t>
                                            <t t-else=""><t t-esc="key"/></t>
                                        </button>
                                    </t>
                                    <button type="button"
                                            class="o_mobile_pos_numkey o_mobile_pos_numkey_clear"
                                            t-on-click="() => this.pressKey('C')">C</button>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>

                <button type="button"
                        class="o_mobile_pos_checkout_btn"
                        t-att-disabled="!state.cart.length || state.processing"
                        t-on-click="confirmSale">
                    <i t-if="state.processing" class="fa fa-circle-o-notch fa-spin"/>
                    <t t-if="!state.processing">
                        Confirm &amp; Print — LKR <t t-esc="formatMoney(total)"/>
                    </t>
                    <t t-else="">Processing...</t>
                </button>
            </div>

            <!-- ============ PRODUCT DETAILS OVERLAY ============ -->
            <div t-if="state.detailsProduct" class="o_mobile_pos_details_overlay" t-on-click="closeDetails">
                <div class="o_mobile_pos_details_panel" t-on-click.stop="() => {}">

                    <button type="button" class="o_mobile_pos_details_close" t-on-click="closeDetails">
                        <i class="fa fa-times"/>
                    </button>

                    <div class="o_mobile_pos_details_img">
                        <img t-att-src="productImageUrl(state.detailsProduct)" alt="product"/>
                    </div>

                    <div class="o_mobile_pos_details_body">
                        <div class="o_mobile_pos_details_name" t-esc="state.detailsProduct.name"/>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.category_id">
                            <span class="o_mobile_pos_details_label">Category</span>
                            <span t-esc="state.detailsProduct.category_id[1]"/>
                        </div>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.brand">
                            <span class="o_mobile_pos_details_label">Brand</span>
                            <span t-esc="state.detailsProduct.brand"/>
                        </div>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.model_name">
                            <span class="o_mobile_pos_details_label">Model</span>
                            <span t-esc="state.detailsProduct.model_name"/>
                        </div>

                        <div class="o_mobile_pos_details_row" t-if="state.detailsProduct.spec_summary">
                            <span class="o_mobile_pos_details_label">Specifications</span>
                            <span t-esc="state.detailsProduct.spec_summary"/>
                        </div>

                        <div class="o_mobile_pos_details_row">
                            <span class="o_mobile_pos_details_label">Warranty</span>
                            <span t-if="state.detailsProduct.warranty" t-esc="state.detailsProduct.warranty"/>
                            <span t-if="!state.detailsProduct.warranty" class="o_mobile_pos_details_none">No warranty</span>
                        </div>

                        <div class="o_mobile_pos_details_row">
                            <span class="o_mobile_pos_details_label">In Stock</span>
                            <span t-esc="state.detailsProduct.stock_quantity"/>
                        </div>

                        <div t-if="state.detailsProduct.has_discount" class="o_mobile_pos_details_price_wrap">
                            <span class="o_mobile_pos_details_price_old">
                                LKR <t t-esc="formatMoney(state.detailsProduct.selling_price)"/>
                            </span>
                            <span class="o_mobile_pos_details_price o_mobile_pos_details_price_sale">
                                LKR <t t-esc="formatMoney(state.detailsProduct.discount_price)"/>
                            </span>
                            <span class="o_mobile_pos_details_discount_chip">
                                -<t t-esc="Math.round(state.detailsProduct.discount_percent)"/>%
                            </span>
                        </div>
                        <div t-else="" class="o_mobile_pos_details_price">
                            LKR <t t-esc="formatMoney(state.detailsProduct.selling_price)"/>
                        </div>

                        <button type="button"
                                class="o_mobile_pos_details_add_btn"
                                t-att-disabled="state.detailsProduct.stock_quantity &lt;= 0"
                                t-on-click="() => this.addToCartFromDetails(state.detailsProduct)">
                            <i class="fa fa-cart-plus"/> Add to Bill
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </t>

</templates>