<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mobile_shop_pos.StockScreen">
        <div class="o_mobile_pos o_mobile_stock_screen">

            <!-- ============ LEFT: PRODUCTS INVENTORY ============ -->
            <div class="o_mobile_pos_products">

                <div class="o_mobile_pos_topbar">
                    <div class="o_mobile_pos_brand">
                        <div class="o_mobile_pos_brand_icon o_mobile_brand_icon_stock">
                            <i class="fa fa-truck" role="img"/>
                        </div>
                        <div class="o_mobile_pos_brand_text">
                            <span class="o_mobile_pos_brand_title">Receive Stock</span>
                            <span class="o_mobile_pos_brand_sub">Inventory Restocking &amp; Purchase Log</span>
                        </div>
                    </div>


                    <div class="o_mobile_pos_search">
                        <i class="fa fa-search"/>
                        <input type="text"
                               placeholder="Search products to restock, brand, model..."
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"/>
                        <i t-if="state.searchTerm"
                           class="fa fa-times o_mobile_pos_search_clear"
                           title="Clear search"
                           t-on-click="clearSearch"/>
                    </div>
                </div>

                <div class="o_mobile_scan_bar">
                    <div class="o_mobile_scan_icon">
                        <i class="fa fa-barcode"/>
                    </div>
                    <input type="text"
                           t-ref="scanInput"
                           placeholder="Scan barcode or press Enter to add to restock list..."
                           t-att-value="state.scanTerm"
                           t-on-input="onScanInput"
                           t-on-keydown="onScanKeydown"/>
                    <div class="o_mobile_scan_badge_group">
                        <span class="o_mobile_scan_kbd_hint"><i class="fa fa-level-down fa-rotate-90"/> Enter</span>
                        <span class="o_mobile_scan_badge">
                            <span class="o_mobile_scan_dot"/>
                            Restock Scanner
                        </span>
                    </div>
                </div>

                <!-- Main Catalog Layout with Cascading Scrollable Navigation Panels -->
                <div class="o_mobile_pos_catalog_layout">

                    <!-- Panel 1: Categories Side Navigation -->
                    <div class="o_mobile_nav_pane o_mobile_pane_categories">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Categories</span>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <t t-foreach="categoryList" t-as="cat" t-key="cat.id || 'all'">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeCategory === cat.id ? 'active' : '')"
                                        t-on-click="() => this.setCategory(cat.id)">
                                    <div class="o_mobile_nav_item_icon">
                                        <i t-att-class="'fa ' + cat.icon"/>
                                    </div>
                                    <span class="o_mobile_nav_item_name" t-esc="cat.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="cat.count"/>
                                    <i t-if="cat.id !== null" class="fa fa-chevron-right o_mobile_nav_item_arrow"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Panel 2: Brands Sub-pane -->
                    <div t-if="state.activeCategory !== null &amp;&amp; availableBrands.length"
                         class="o_mobile_nav_pane o_mobile_pane_brands">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Brands</span>
                            <button t-if="state.activeBrand"
                                    type="button"
                                    class="o_mobile_pane_clear_btn"
                                    t-on-click="clearBrand">All</button>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <button type="button"
                                    t-att-class="'o_mobile_nav_item ' + (state.activeBrand === null ? 'active' : '')"
                                    t-on-click="clearBrand">
                                <span class="o_mobile_nav_item_name">All Brands</span>
                            </button>
                            <t t-foreach="availableBrands" t-as="brand" t-key="brand.name">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeBrand === brand.name ? 'active' : '')"
                                        t-on-click="() => this.setBrand(brand.name)">
                                    <span class="o_mobile_nav_item_name" t-esc="brand.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="brand.count"/>
                                    <i class="fa fa-chevron-right o_mobile_nav_item_arrow"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Panel 3: Models Sub-pane -->
                    <div t-if="state.activeBrand &amp;&amp; availableModels.length"
                         class="o_mobile_nav_pane o_mobile_pane_models">
                        <div class="o_mobile_pane_header o_mobile_nav_pane_header">
                            <span>Models</span>
                            <button t-if="state.activeModel"
                                    type="button"
                                    class="o_mobile_pane_clear_btn"
                                    t-on-click="clearModel">All</button>
                        </div>
                        <div class="o_mobile_pane_list o_mobile_nav_pane_list">
                            <button type="button"
                                    t-att-class="'o_mobile_nav_item ' + (state.activeModel === null ? 'active' : '')"
                                    t-on-click="clearModel">
                                <span class="o_mobile_nav_item_name">All Models</span>
                            </button>
                            <t t-foreach="availableModels" t-as="model" t-key="model.name">
                                <button type="button"
                                        t-att-class="'o_mobile_nav_item ' + (state.activeModel === model.name ? 'active' : '')"
                                        t-on-click="() => this.setModel(model.name)">
                                    <span class="o_mobile_nav_item_name" t-esc="model.name"/>
                                    <span class="o_mobile_nav_item_count" t-esc="model.count"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Products Grid Content Area -->
                    <div class="o_mobile_catalog_content">

                        <!-- Breadcrumbs bar -->
                        <div class="o_mobile_filter_breadcrumb">
                            <div class="o_mobile_breadcrumb_trail">
                                <span class="o_mobile_crumb" t-on-click="resetAllFilters">
                                    <i class="fa fa-home"/> Catalog
                                </span>
                                <t t-if="state.activeCategory !== null">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active" t-esc="activeCategoryName"/>
                                </t>
                                <t t-if="state.activeBrand">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active">
                                        <t t-esc="state.activeBrand"/>
                                        <i class="fa fa-times o_mobile_crumb_remove" t-on-click.stop="clearBrand"/>
                                    </span>
                                </t>
                                <t t-if="state.activeModel">
                                    <i class="fa fa-angle-right o_mobile_crumb_sep"/>
                                    <span class="o_mobile_crumb active">
                                        <t t-esc="state.activeModel"/>
                                        <i class="fa fa-times o_mobile_crumb_remove" t-on-click.stop="clearModel"/>
                                    </span>
                                </t>
                            </div>

                            <div class="o_mobile_catalog_count">
                                <span t-esc="filteredProducts.length"/> products
                            </div>
                        </div>

                        <!-- Products Grid -->
                        <div class="o_mobile_pos_grid_wrapper">
                            <div t-if="state.loading" class="o_mobile_pos_loading">
                                <i class="fa fa-circle-o-notch fa-spin"/>
                                <span>Loading catalog...</span>
                            </div>

                            <div t-elif="!filteredProducts.length" class="o_mobile_pos_empty">
                                <div class="o_mobile_pos_empty_icon">
                                    <i class="fa fa-truck"/>
                                </div>
                                <div class="o_mobile_pos_empty_title">No products found</div>
                                <div class="o_mobile_pos_empty_desc">Try searching for a different item.</div>
                                <button type="button" class="o_mobile_pos_empty_btn" t-on-click="resetAllFilters">
                                    Show All Products
                                </button>
                            </div>

                            <div t-else="" class="o_mobile_pos_grid">
                                <t t-foreach="filteredProducts" t-as="product" t-key="product.id">
                                    <div class="o_mobile_pos_card o_mobile_stock_card"
                                         t-on-click="() => this.addToLines(product)">

                                        <div class="o_mobile_pos_card_img">
                                            <img t-att-src="productImageUrl(product)" alt="product" loading="lazy"/>
                                            <span t-if="lineQtyFor(product.id)"
                                                  class="o_mobile_pos_card_badge">
                                                +<t t-esc="lineQtyFor(product.id)"/>
                                            </span>
                                        </div>

                                        <div class="o_mobile_pos_card_body">
                                            <div class="o_mobile_pos_card_name" t-esc="product.name"/>
                                            <div t-if="productSubtitle(product)"
                                                 class="o_mobile_pos_card_sub"
                                                 t-esc="productSubtitle(product)"/>
                                            
                                            <div class="o_mobile_pos_card_footer">
                                                <div class="o_mobile_pos_card_price_box">
                                                    <span class="o_mobile_pos_card_price">
                                                        Cost: LKR <t t-esc="formatMoney(product.purchase_price)"/>
                                                    </span>
                                                </div>
                                                <span class="o_mobile_pos_card_stock">
                                                    <t t-esc="product.stock_quantity"/> in stock
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- ============ RIGHT: STOCK-IN MANIFEST ============ -->
            <div class="o_mobile_pos_cart o_mobile_stock_cart">

                <div class="o_mobile_pos_cart_header">
                    <span class="o_mobile_pos_order_title">Items to Restock</span>
                    <button type="button"
                            class="o_mobile_clear_link_btn"
                            t-if="state.lines.length"
                            t-on-click="clearLines">
                        <i class="fa fa-trash-o"/> Clear
                    </button>
                </div>

                <div class="o_mobile_pos_order_content">
                    <div t-if="!state.lines.length" class="o_mobile_pos_order_empty_card">
                        <p>Scan or tap a product on the left to add it to this restocking order.</p>
                    </div>

                    <div t-else="" class="o_mobile_pos_cart_lines_list">
                        <t t-foreach="state.lines" t-as="line" t-key="line.productId">
                            <div class="o_mobile_stock_line_card">
                                <div class="o_mobile_stock_line_header">
                                    <div class="o_mobile_pos_line_name" t-esc="line.name"/>
                                    <button type="button"
                                            class="o_mobile_pos_line_remove"
                                            title="Remove item"
                                            t-on-click="() => this.removeLine(line)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                                
                                <div class="o_mobile_stock_line_details">
                                    <span class="o_mobile_stock_curr_caption">
                                        Currently: <t t-esc="line.currentStock"/> in stock
                                    </span>
                                </div>

                                <div class="o_mobile_stock_line_controls">
                                    <div class="o_mobile_pos_line_qty">
                                        <button type="button" class="o_mobile_qty_btn" t-on-click="() => this.decrementLine(line)">-</button>
                                        <input type="number"
                                               min="1"
                                               class="o_mobile_qty_input"
                                               t-att-value="line.qty"
                                               t-on-change="(ev) => this.onLineQtyInput(line, ev)"/>
                                        <button type="button" class="o_mobile_qty_btn" t-on-click="() => this.incrementLine(line)">+</button>
                                    </div>

                                    <div class="o_mobile_stock_cost_input_group">
                                        <label>Cost LKR</label>
                                        <input type="number"
                                               step="0.01"
                                               min="0"
                                               t-att-value="line.costPrice"
                                               t-on-change="(ev) => this.onLineCostInput(line, ev)"/>
                                    </div>

                                    <div class="o_mobile_stock_line_total">
                                        LKR <t t-esc="formatMoney(line.qty * line.costPrice)"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="o_mobile_pos_order_divider"/>

                <div class="o_mobile_pos_totals_block">
                    <div class="o_mobile_pos_total_row o_mobile_pos_subtotal_row">
                        <span>Total Items Added</span>
                        <span class="fw-bold"><t t-esc="lineCount"/> units</span>
                    </div>
                    <div class="o_mobile_pos_total_row o_mobile_pos_grand_total_row">
                        <span>Total Cost</span>
                        <span>LKR <t t-esc="formatMoney(total)"/></span>
                    </div>
                </div>

                <button type="button"
                        class="o_mobile_pos_charge_btn o_mobile_stock_submit_btn"
                        t-att-disabled="!state.lines.length || state.processing"
                        t-on-click="confirmStockIn">
                    <i t-if="state.processing" class="fa fa-circle-o-notch fa-spin"/>
                    <t t-if="!state.processing">
                        <i class="fa fa-check-circle"/> Confirm &amp; Add to Stock — LKR <t t-esc="formatMoney(total)"/>
                    </t>
                    <t t-else="">Updating Inventory...</t>
                </button>
            </div>
        </div>
    </t>

</templates>
