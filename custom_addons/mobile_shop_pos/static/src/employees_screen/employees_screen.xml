<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mobile_shop_pos.EmployeesScreen">
        <div class="o_mobile_pos o_mobile_employees_screen">

            <div class="o_mobile_pos_products">

                <div class="o_mobile_pos_topbar">
                    <div class="o_mobile_pos_brand">
                        <i class="fa fa-users" role="img"/>
                        <span>Manage Employees</span>
                    </div>

                    <button type="button"
                            class="o_mobile_products_add_btn"
                            t-if="state.activeTab === 'employees'"
                            t-on-click="openNewEmployee">
                        <i class="fa fa-plus"/> Add Employee
                    </button>

                    <button type="button"
                            class="o_mobile_products_add_btn"
                            t-if="state.activeTab === 'salary'"
                            t-on-click="openNewPayment">
                        <i class="fa fa-plus"/> Log Payment
                    </button>
                </div>

                <div class="o_mobile_pos_categories">
                    <button type="button"
                            t-att-class="'o_mobile_pos_cat_btn ' + (state.activeTab === 'employees' ? 'active' : '')"
                            t-on-click="() => this.setTab('employees')">
                        <i class="fa fa-id-badge"/> Employees
                    </button>
                    <button type="button"
                            t-att-class="'o_mobile_pos_cat_btn ' + (state.activeTab === 'attendance' ? 'active' : '')"
                            t-on-click="() => this.setTab('attendance')">
                        <i class="fa fa-clock-o"/> Attendance
                    </button>
                    <button type="button"
                            t-att-class="'o_mobile_pos_cat_btn ' + (state.activeTab === 'salary' ? 'active' : '')"
                            t-on-click="() => this.setTab('salary')">
                        <i class="fa fa-money"/> Salary
                    </button>
                    <button type="button"
                            t-att-class="'o_mobile_pos_cat_btn ' + (state.activeTab === 'sales' ? 'active' : '')"
                            t-on-click="() => this.setTab('sales')">
                        <i class="fa fa-bar-chart"/> Sales by Employee
                    </button>
                </div>

                <!-- Employees Tab -->
                <t t-if="state.activeTab === 'employees'">
                    <div class="o_mobile_pos_topbar">
                        <div class="o_mobile_pos_search">
                            <i class="fa fa-search"/>
                            <input type="text"
                                   placeholder="Search employees..."
                                   t-att-value="state.empSearchTerm"
                                   t-on-input="onEmpSearchInput"/>
                        </div>
                        <button type="button"
                                t-att-class="'o_mobile_pos_cat_btn ' + (state.showArchived ? 'active' : '')"
                                t-on-click="toggleShowArchived">
                            <i class="fa fa-archive"/> Show Archived
                        </button>
                    </div>

                    <div class="o_mobile_pos_grid_wrapper">
                        <div t-if="state.empLoading" class="o_mobile_pos_loading">
                            <i class="fa fa-circle-o-notch fa-spin"/> Loading employees...
                        </div>
                        <div t-elif="!filteredEmployees.length" class="o_mobile_pos_empty">
                            <i class="fa fa-inbox"/>
                            <div>No employees found</div>
                        </div>
                        <table t-else="" class="o_mobile_report_table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Position</th>
                                    <th>Phone</th>
                                    <th>Joined</th>
                                    <th class="text-end">Salary</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="filteredEmployees" t-as="emp" t-key="emp.id">
                                    <tr t-att-class="!emp.active ? 'o_mobile_bill_row_cancelled' : ''"
                                        t-on-click="() => this.openEditEmployee(emp)">
                                        <td class="o_mobile_report_row_name"><t t-esc="emp.name"/></td>
                                        <td><t t-esc="emp.position_id ? emp.position_id[1] : '—'"/></td>
                                        <td><t t-esc="emp.phone || '—'"/></td>
                                        <td><t t-esc="emp.join_date || '—'"/></td>
                                        <td class="text-end">LKR <t t-esc="formatMoney(emp.basic_salary)"/></td>
                                        <td>
                                            <span t-if="emp.active" class="o_mobile_bill_status o_mobile_bill_status_confirmed">Active</span>
                                            <span t-else="" class="o_mobile_bill_status o_mobile_bill_status_cancelled">Archived</span>
                                            <button t-if="!emp.active"
                                                    type="button"
                                                    class="o_mobile_employee_reactivate_btn"
                                                    t-on-click.stop="() => this.reactivateEmployee(emp)">
                                                Reactivate
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Attendance Tab -->
                <t t-if="state.activeTab === 'attendance'">
                    <div class="o_mobile_pos_categories">
                        <t t-foreach="attDateFilters" t-as="df" t-key="df.key">
                            <button type="button"
                                    t-att-class="'o_mobile_pos_cat_btn ' + (state.attDateFilter === df.key ? 'active' : '')"
                                    t-on-click="() => this.setAttDateFilter(df.key)">
                                <t t-esc="df.label"/>
                            </button>
                        </t>
                    </div>

                    <div class="o_mobile_pos_topbar">
                        <select class="o_mobile_employee_filter_select" t-on-change="setAttEmployeeFilter">
                            <option value="">All Employees</option>
                            <t t-foreach="state.employees" t-as="emp" t-key="emp.id">
                                <option t-att-value="emp.id"><t t-esc="emp.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="o_mobile_pos_grid_wrapper">
                        <div t-if="state.attendanceLoading" class="o_mobile_pos_loading">
                            <i class="fa fa-circle-o-notch fa-spin"/> Loading attendance...
                        </div>
                        <div t-elif="!filteredAttendance.length" class="o_mobile_pos_empty">
                            <i class="fa fa-inbox"/>
                            <div>No attendance records found</div>
                        </div>
                        <table t-else="" class="o_mobile_report_table">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Login</th>
                                    <th>Logout</th>
                                    <th class="text-end">Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="filteredAttendance" t-as="att" t-key="att.id">
                                    <tr>
                                        <td class="o_mobile_report_row_name">
                                            <t t-esc="att.employee_id ? att.employee_id[1] : '—'"/>
                                        </td>
                                        <td><t t-esc="formatDateTime(att.login_time)"/></td>
                                        <td>
                                            <t t-if="att.logout_time" t-esc="formatDateTime(att.logout_time)"/>
                                            <span t-else="" class="o_mobile_bill_status o_mobile_bill_status_draft">Still In</span>
                                        </td>
                                        <td class="text-end">
                                            <t t-if="att.logout_time" t-esc="att.duration_hours.toFixed(1)"/>
                                            <t t-else="">—</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Salary Tab -->
                <t t-if="state.activeTab === 'salary'">
                    <div class="o_mobile_pos_topbar">
                        <select class="o_mobile_employee_filter_select" t-on-change="setPaymentEmployeeFilter">
                            <option value="">All Employees</option>
                            <t t-foreach="state.employees" t-as="emp" t-key="emp.id">
                                <option t-att-value="emp.id"><t t-esc="emp.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="o_mobile_report_summary">
                        <div class="o_mobile_report_card">
                            <span class="o_mobile_report_card_label">Payments</span>
                            <span class="o_mobile_report_card_value"><t t-esc="filteredPayments.length"/></span>
                        </div>
                        <div class="o_mobile_report_card o_mobile_report_card_profit">
                            <span class="o_mobile_report_card_label">Total Paid</span>
                            <span class="o_mobile_report_card_value">LKR <t t-esc="formatMoney(paymentsTotal)"/></span>
                        </div>
                    </div>

                    <div class="o_mobile_pos_grid_wrapper">
                        <div t-if="state.paymentsLoading" class="o_mobile_pos_loading">
                            <i class="fa fa-circle-o-notch fa-spin"/> Loading payments...
                        </div>
                        <div t-elif="!filteredPayments.length" class="o_mobile_pos_empty">
                            <i class="fa fa-inbox"/>
                            <div>No salary payments logged</div>
                        </div>
                        <table t-else="" class="o_mobile_report_table">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Date</th>
                                    <th>For Month</th>
                                    <th class="text-end">Amount</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="filteredPayments" t-as="p" t-key="p.id">
                                    <tr>
                                        <td class="o_mobile_report_row_name">
                                            <t t-esc="p.employee_id ? p.employee_id[1] : '—'"/>
                                        </td>
                                        <td><t t-esc="p.payment_date"/></td>
                                        <td><t t-esc="p.for_month || '—'"/></td>
                                        <td class="text-end">LKR <t t-esc="formatMoney(p.amount)"/></td>
                                        <td><t t-esc="p.notes || '—'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Sales by Employee Tab -->
                <t t-if="state.activeTab === 'sales'">
                    <div class="o_mobile_pos_categories">
                        <t t-foreach="salesDateFilters" t-as="df" t-key="df.key">
                            <button type="button"
                                    t-att-class="'o_mobile_pos_cat_btn ' + (state.salesDateFilter === df.key ? 'active' : '')"
                                    t-on-click="() => this.setSalesDateFilter(df.key)">
                                <t t-esc="df.label"/>
                            </button>
                        </t>
                    </div>

                    <div class="o_mobile_report_summary">
                        <div class="o_mobile_report_card">
                            <span class="o_mobile_report_card_label">Bills</span>
                            <span class="o_mobile_report_card_value"><t t-esc="salesTotals.bills"/></span>
                        </div>
                        <div class="o_mobile_report_card o_mobile_report_card_profit">
                            <span class="o_mobile_report_card_label">Revenue</span>
                            <span class="o_mobile_report_card_value">LKR <t t-esc="formatMoney(salesTotals.revenue)"/></span>
                        </div>
                    </div>

                    <div class="o_mobile_pos_grid_wrapper">
                        <div t-if="state.salesLoading" class="o_mobile_pos_loading">
                            <i class="fa fa-circle-o-notch fa-spin"/> Loading sales...
                        </div>
                        <div t-elif="!state.salesRows.length" class="o_mobile_pos_empty">
                            <i class="fa fa-inbox"/>
                            <div>No confirmed sales in this period</div>
                        </div>
                        <table t-else="" class="o_mobile_report_table">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th class="text-end">Bills</th>
                                    <th class="text-end">Revenue</th>
                                    <th class="text-end">Discount Given</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.salesRows" t-as="row" t-key="row.cashierId">
                                    <tr>
                                        <td class="o_mobile_report_row_name"><t t-esc="row.cashierName"/></td>
                                        <td class="text-end"><t t-esc="row.billCount"/></td>
                                        <td class="text-end">LKR <t t-esc="formatMoney(row.revenue)"/></td>
                                        <td class="text-end">LKR <t t-esc="formatMoney(row.discount)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

            </div>

            <!-- Slide-over Panel: Employee or Payment -->
            <div t-if="state.panelOpen" class="o_mobile_products_overlay" t-on-click="closePanel"/>

            <div t-att-class="'o_mobile_products_panel ' + (state.panelOpen ? 'open' : '')">

                <!-- Employee form -->
                <t t-if="state.panelMode === 'employee'">
                    <div class="o_mobile_products_panel_header">
                        <span t-if="state.isNewEmployee">Add Employee</span>
                        <span t-else="">Edit Employee</span>
                        <button type="button" class="o_mobile_products_panel_close" t-on-click="closePanel">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="o_mobile_products_panel_body">
                        <t t-if="state.isNewEmployee">
                            <div class="o_mobile_pos_categories o_mobile_employee_mode_toggle">
                                <button type="button"
                                        t-att-class="'o_mobile_pos_cat_btn ' + (state.empForm.loginMode === 'new' ? 'active' : '')"
                                        t-on-click="() => this.setLoginMode('new')">
                                    Create New Login
                                </button>
                                <button type="button"
                                        t-att-class="'o_mobile_pos_cat_btn ' + (state.empForm.loginMode === 'existing' ? 'active' : '')"
                                        t-on-click="() => this.setLoginMode('existing')">
                                    Link Existing User
                                </button>
                            </div>

                            <t t-if="state.empForm.loginMode === 'new'">
                                <div class="o_mobile_products_field">
                                    <label>Full Name</label>
                                    <input type="text" t-att-value="state.empForm.new_name" t-on-input="(ev) => this.onEmpFieldInput('new_name', ev)"/>
                                </div>
                                <div class="o_mobile_products_field">
                                    <label>Login / Email</label>
                                    <input type="text" t-att-value="state.empForm.new_login" t-on-input="(ev) => this.onEmpFieldInput('new_login', ev)"/>
                                </div>
                                <div class="o_mobile_products_field_row">
                                    <div class="o_mobile_products_field">
                                        <label>Password</label>
                                        <input type="password" t-att-value="state.empForm.new_password" t-on-input="(ev) => this.onEmpFieldInput('new_password', ev)"/>
                                    </div>
                                    <div class="o_mobile_products_field">
                                        <label>Confirm Password</label>
                                        <input type="password" t-att-value="state.empForm.new_password_confirm" t-on-input="(ev) => this.onEmpFieldInput('new_password_confirm', ev)"/>
                                    </div>
                                </div>
                                <div class="o_mobile_products_field">
                                    <label>Role</label>
                                    <div class="o_mobile_pos_categories">
                                        <button type="button"
                                                t-att-class="'o_mobile_pos_cat_btn ' + (state.empForm.role === 'cashier' ? 'active' : '')"
                                                t-on-click="() => this.setRole('cashier')">
                                            Cashier
                                        </button>
                                        <button type="button"
                                                t-att-class="'o_mobile_pos_cat_btn ' + (state.empForm.role === 'manager' ? 'active' : '')"
                                                t-on-click="() => this.setRole('manager')">
                                            Owner / Manager
                                        </button>
                                    </div>
                                </div>
                            </t>

                            <t t-else="">
                                <div class="o_mobile_products_field">
                                    <label>Login Account</label>
                                    <select t-on-change="onEmpUserChange">
                                        <option value="">Select a system user...</option>
                                        <t t-foreach="state.availableUsers" t-as="u" t-key="u.id">
                                            <option t-att-value="u.id"><t t-esc="u.name"/> (<t t-esc="u.login"/>)</option>
                                        </t>
                                    </select>
                                    <div t-if="!state.availableUsers.length" class="o_mobile_products_hint">
                                        No unlinked users found — every existing login already has an employee profile.
                                    </div>
                                </div>
                            </t>
                        </t>
                        <div class="o_mobile_products_field" t-else="">
                            <label>Login Account</label>
                            <input type="text" t-att-value="state.empForm.user_name" disabled="disabled"/>
                        </div>

                        <div class="o_mobile_products_field">
                            <label>Position</label>
                            <div class="o_mobile_products_field_row">
                                <select t-on-change="onEmpPositionChange">
                                    <t t-foreach="state.positions" t-as="pos" t-key="pos.id">
                                        <option t-att-value="pos.id" t-att-selected="state.empForm.position_id === pos.id">
                                            <t t-esc="pos.name"/>
                                        </option>
                                    </t>
                                </select>
                                <button type="button" class="o_mobile_products_upload_btn" t-on-click="createNewPosition">
                                    <i class="fa fa-plus"/> New
                                </button>
                            </div>
                        </div>

                        <div class="o_mobile_products_field_row">
                            <div class="o_mobile_products_field">
                                <label>Phone</label>
                                <input type="text" t-att-value="state.empForm.phone" t-on-input="(ev) => this.onEmpFieldInput('phone', ev)"/>
                            </div>
                            <div class="o_mobile_products_field">
                                <label>NIC / ID Number</label>
                                <input type="text" t-att-value="state.empForm.nic" t-on-input="(ev) => this.onEmpFieldInput('nic', ev)"/>
                            </div>
                        </div>

                        <div class="o_mobile_products_field_row">
                            <div class="o_mobile_products_field">
                                <label>Joined On</label>
                                <input type="date" t-att-value="state.empForm.join_date" t-on-change="(ev) => this.onEmpFieldInput('join_date', ev)"/>
                            </div>
                            <div class="o_mobile_products_field">
                                <label>Basic Salary</label>
                                <input type="number" step="0.01" min="0" t-att-value="state.empForm.basic_salary" t-on-input="(ev) => this.onEmpNumberInput('basic_salary', ev)"/>
                            </div>
                        </div>

                        <div class="o_mobile_products_field">
                            <label>Notes</label>
                            <textarea rows="3" t-att-value="state.empForm.notes" t-on-input="(ev) => this.onEmpFieldInput('notes', ev)"/>
                        </div>
                    </div>

                    <div class="o_mobile_products_panel_footer">
                        <button type="button"
                                class="o_mobile_products_delete_btn"
                                t-if="!state.isNewEmployee and state.empForm.active"
                                t-on-click="archiveEmployee">
                            <i class="fa fa-archive"/> Archive &amp; Disable Login
                        </button>
                        <button type="button"
                                class="o_mobile_products_save_btn"
                                t-att-disabled="state.empSaving"
                                t-on-click="saveEmployee">
                            <i t-if="state.empSaving" class="fa fa-circle-o-notch fa-spin"/>
                            <t t-if="!state.empSaving">Save</t>
                            <t t-else="">Saving...</t>
                        </button>
                    </div>
                </t>

                <!-- Salary payment form -->
                <t t-if="state.panelMode === 'payment'">
                    <div class="o_mobile_products_panel_header">
                        <span>Log Salary Payment</span>
                        <button type="button" class="o_mobile_products_panel_close" t-on-click="closePanel">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="o_mobile_products_panel_body">
                        <div class="o_mobile_products_field">
                            <label>Employee</label>
                            <select t-on-change="onPaymentEmployeeChange">
                                <t t-foreach="state.employees.filter((e) => e.active)" t-as="emp" t-key="emp.id">
                                    <option t-att-value="emp.id" t-att-selected="state.paymentForm.employee_id === emp.id">
                                        <t t-esc="emp.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="o_mobile_products_field_row">
                            <div class="o_mobile_products_field">
                                <label>Payment Date</label>
                                <input type="date" t-att-value="state.paymentForm.payment_date" t-on-change="(ev) => this.onPaymentFieldInput('payment_date', ev)"/>
                            </div>
                            <div class="o_mobile_products_field">
                                <label>Amount</label>
                                <input type="number" step="0.01" min="0" t-att-value="state.paymentForm.amount" t-on-input="(ev) => this.onPaymentNumberInput('amount', ev)"/>
                            </div>
                        </div>

                        <div class="o_mobile_products_field">
                            <label>For Month <span class="o_mobile_products_hint">(e.g. "September 2026")</span></label>
                            <input type="text" t-att-value="state.paymentForm.for_month" t-on-input="(ev) => this.onPaymentFieldInput('for_month', ev)"/>
                        </div>

                        <div class="o_mobile_products_field">
                            <label>Notes</label>
                            <input type="text" t-att-value="state.paymentForm.notes" t-on-input="(ev) => this.onPaymentFieldInput('notes', ev)"/>
                        </div>
                    </div>

                    <div class="o_mobile_products_panel_footer">
                        <button type="button"
                                class="o_mobile_products_save_btn"
                                t-att-disabled="state.paymentSaving"
                                t-on-click="savePayment">
                            <i t-if="state.paymentSaving" class="fa fa-circle-o-notch fa-spin"/>
                            <t t-if="!state.paymentSaving">Log Payment</t>
                            <t t-else="">Saving...</t>
                        </button>
                    </div>
                </t>

            </div>
        </div>
    </t>

</templates>
