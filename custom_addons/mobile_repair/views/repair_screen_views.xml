<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <menuitem
        id="mobile_repair_menu_root"
        name="Repair"
        groups="mobile_shop_pos.group_mobile_shop_cashier,mobile_shop_pos.group_mobile_shop_manager"
        sequence="20"/>

    <record id="mobile_repair_screen_action" model="ir.actions.client">
        <field name="name">Repair Screen</field>
        <field name="tag">mobile_repair.repair_screen</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="mobile_repair_screen_menu"
        name="Repair Screen"
        parent="mobile_repair_menu_root"
        action="mobile_repair_screen_action"
        groups="mobile_shop_pos.group_mobile_shop_cashier,mobile_shop_pos.group_mobile_shop_manager"
        sequence="1"/>

</odoo>
