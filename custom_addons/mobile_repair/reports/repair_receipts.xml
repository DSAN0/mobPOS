<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============ INTAKE RECEIPT ============ -->

    <record id="action_report_repair_intake" model="ir.actions.report">
        <field name="name">Repair Intake Receipt</field>
        <field name="model">mobile.repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mobile_repair.report_repair_intake_document</field>
        <field name="report_file">mobile_repair.report_repair_intake_document</field>
        <field name="print_report_name">'Intake Receipt - %s' % (object.name)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_mobile_repair_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_repair_intake_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.env.company"/>
                <t t-call="web.basic_layout">

                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; color:#222; padding: 10px 30px;">

                        <div style="display:flex; align-items:center; justify-content:space-between; border-bottom: 4px solid #0d9488; padding-bottom: 16px; margin-bottom: 20px;">
                            <div style="display:flex; align-items:center;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                     style="max-height: 70px; max-width: 160px; margin-right: 18px;"/>
                                <div>
                                    <div style="font-size: 22px; font-weight: bold; color:#0d9488;">
                                        <span t-field="company.name"/>
                                    </div>
                                    <div style="font-size: 11px; color:#555;" t-if="company.street or company.city">
                                        <span t-field="company.street"/>
                                        <span t-if="company.city">, </span>
                                        <span t-field="company.city"/>
                                    </div>
                                    <div style="font-size: 11px; color:#555;" t-if="company.phone or company.email">
                                        <span t-if="company.phone" t-field="company.phone"/>
                                        <span t-if="company.phone and company.email"> · </span>
                                        <span t-if="company.email" t-field="company.email"/>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size: 20px; font-weight: bold; color:#0d9488;">REPAIR INTAKE RECEIPT</div>
                                <div style="font-size: 13px; margin-top: 4px;">
                                    Job No: <strong t-field="doc.name"/>
                                </div>
                            </div>
                        </div>

                        <table style="width:100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
                            <tr>
                                <td style="padding:6px 0; width:50%; vertical-align:top;">
                                    <div style="color:#777; font-size:11px;">RECEIVED DATE &amp; TIME</div>
                                    <div style="font-weight:bold;">
                                        <span t-field="doc.received_date" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy, hh:mm a'}"/>
                                    </div>
                                </td>
                                <td style="padding:6px 0; vertical-align:top;">
                                    <div style="color:#777; font-size:11px;">CUSTOMER</div>
                                    <div style="font-weight:bold;"><span t-field="doc.customer_name"/></div>
                                    <div><span t-field="doc.customer_phone"/></div>
                                </td>
                            </tr>
                        </table>

                        <table style="width:100%; border-collapse: collapse; font-size: 13px;">
                            <thead>
                                <tr style="background-color:#0d9488; color:#fff;">
                                    <th style="padding:8px; text-align:left; width:30%;">Device</th>
                                    <th style="padding:8px; text-align:left;">Reported Issue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color:#eefaf8;">
                                    <td style="padding:10px; border-bottom:1px solid #eee; vertical-align:top;">
                                        <span t-field="doc.device"/>
                                    </td>
                                    <td style="padding:10px; border-bottom:1px solid #eee; vertical-align:top;">
                                        <span t-field="doc.issue_description"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="display:flex; justify-content:flex-end; margin-top: 18px;">
                            <table style="width: 280px; font-size: 13px;">
                                <tr>
                                    <td style="padding:4px 8px; font-weight:bold; font-size:15px;">Estimated Cost</td>
                                    <td style="padding:4px 8px; text-align:right; font-weight:bold; font-size:15px; color:#0d9488;">
                                        LKR <span t-field="doc.cost" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-top: 40px; border-top: 1px solid #ddd; padding-top: 14px; font-size: 11px; color:#777; text-align:center;">
                            <div>Please retain this receipt — it must be presented when collecting your device.</div>
                            <div style="margin-top:4px;">Final cost may vary from the estimate above depending on the actual repair required.</div>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>


    <!-- ============ DELIVERY RECEIPT ============ -->

    <record id="action_report_repair_delivery" model="ir.actions.report">
        <field name="name">Repair Delivery Receipt</field>
        <field name="model">mobile.repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mobile_repair.report_repair_delivery_document</field>
        <field name="report_file">mobile_repair.report_repair_delivery_document</field>
        <field name="print_report_name">'Delivery Receipt - %s' % (object.name)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_mobile_repair_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_repair_delivery_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.env.company"/>
                <t t-call="web.basic_layout">

                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; color:#222; padding: 10px 30px;">

                        <div style="display:flex; align-items:center; justify-content:space-between; border-bottom: 4px solid #0d9488; padding-bottom: 16px; margin-bottom: 20px;">
                            <div style="display:flex; align-items:center;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                     style="max-height: 70px; max-width: 160px; margin-right: 18px;"/>
                                <div>
                                    <div style="font-size: 22px; font-weight: bold; color:#0d9488;">
                                        <span t-field="company.name"/>
                                    </div>
                                    <div style="font-size: 11px; color:#555;" t-if="company.street or company.city">
                                        <span t-field="company.street"/>
                                        <span t-if="company.city">, </span>
                                        <span t-field="company.city"/>
                                    </div>
                                    <div style="font-size: 11px; color:#555;" t-if="company.phone or company.email">
                                        <span t-if="company.phone" t-field="company.phone"/>
                                        <span t-if="company.phone and company.email"> · </span>
                                        <span t-if="company.email" t-field="company.email"/>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size: 20px; font-weight: bold; color:#0d9488;">REPAIR DELIVERY RECEIPT</div>
                                <div style="font-size: 13px; margin-top: 4px;">
                                    Job No: <strong t-field="doc.name"/>
                                </div>
                            </div>
                        </div>

                        <table style="width:100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
                            <tr>
                                <td style="padding:6px 0; width:33%; vertical-align:top;">
                                    <div style="color:#777; font-size:11px;">RECEIVED DATE &amp; TIME</div>
                                    <div style="font-weight:bold;">
                                        <span t-field="doc.received_date" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy, hh:mm a'}"/>
                                    </div>
                                </td>
                                <td style="padding:6px 0; width:33%; vertical-align:top;">
                                    <div style="color:#777; font-size:11px;">HANDOVER DATE &amp; TIME</div>
                                    <div style="font-weight:bold;">
                                        <span t-if="doc.delivered_date" t-field="doc.delivered_date" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy, hh:mm a'}"/>
                                        <span t-if="not doc.delivered_date" style="color:#999;">—</span>
                                    </div>
                                </td>
                                <td style="padding:6px 0; vertical-align:top;">
                                    <div style="color:#777; font-size:11px;">CUSTOMER</div>
                                    <div style="font-weight:bold;"><span t-field="doc.customer_name"/></div>
                                    <div><span t-field="doc.customer_phone"/></div>
                                </td>
                            </tr>
                        </table>

                        <table style="width:100%; border-collapse: collapse; font-size: 13px;">
                            <thead>
                                <tr style="background-color:#0d9488; color:#fff;">
                                    <th style="padding:8px; text-align:left; width:30%;">Device</th>
                                    <th style="padding:8px; text-align:left;">Issue Repaired</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color:#eefaf8;">
                                    <td style="padding:10px; border-bottom:1px solid #eee; vertical-align:top;">
                                        <span t-field="doc.device"/>
                                    </td>
                                    <td style="padding:10px; border-bottom:1px solid #eee; vertical-align:top;">
                                        <span t-field="doc.issue_description"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="display:flex; justify-content:flex-end; margin-top: 18px;">
                            <table style="width: 280px; font-size: 13px;">
                                <tr>
                                    <td style="padding:4px 8px; font-weight:bold; font-size:16px;">Final Cost</td>
                                    <td style="padding:4px 8px; text-align:right; font-weight:bold; font-size:16px; color:#0d9488;">
                                        LKR <span t-field="doc.cost" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-top: 60px; display:flex; justify-content:space-between;">
                            <div style="width: 40%; border-top: 1px solid #999; padding-top: 6px; font-size: 11px; text-align:center; color:#555;">
                                Handed over by (Shop)
                            </div>
                            <div style="width: 40%; border-top: 1px solid #999; padding-top: 6px; font-size: 11px; text-align:center; color:#555;">
                                Received by (Customer)
                            </div>
                        </div>

                        <div style="margin-top: 30px; border-top: 1px solid #ddd; padding-top: 14px; font-size: 11px; color:#777; text-align:center;">
                            <div>Thank you for choosing us for your repair needs!</div>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
